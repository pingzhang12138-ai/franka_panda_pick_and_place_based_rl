<?xml version='1.0' encoding='utf-8'?>
<mujoco model="panda_rl_env">

  <!-- ==================== 编译器与仿真选项 ==================== -->
  <compiler angle="radian" meshdir="../mujoco_menagerie/franka_emika_panda/assets" />
  <option integrator="implicitfast" timestep="0.002" />

  <!-- ==================== 可视化全局设置 ==================== -->
  <visual>
    <global ellipsoidinertia="true" />  <!-- 显示惯量椭球体，调试用 -->
  </visual>

  <!-- ==================== 默认参数层级 ==================== -->
  <default>
    <!-- 顶层 Panda 默认类，所有机械臂关节/执行器/几何继承 -->
    <default class="panda">
      <material specular="0.5" shininess="0.25" />
      <joint armature="0.1" damping="1" axis="0 0 1" range="-2.8973 2.8973" />
      <general dyntype="none" biastype="affine" ctrlrange="-2.8973 2.8973" forcerange="-87 87" />

      <!-- 手指关节（滑动副） -->
      <default class="finger">
        <joint axis="0 1 0" type="slide" range="0 0.04" />
      </default>

      <!-- 视觉几何（无碰撞） -->
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" />
      </default>

      <!-- 碰撞几何（物理使用） -->
      <default class="collision">
        <geom  type="mesh" group="3" />
        <!-- 指尖碰撞块精细定义（5个小盒体） -->
        <default class="fingertip_pad_collision_1">
          <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445"
                condim="4" friction="0.9 0.01 0.001"
                solimp="0.9 0.99 0.001" solref="0.005 1" margin="0.001" contype="1" conaffinity="1" />
        </default>
        <default class="fingertip_pad_collision_2">
          <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05"
                condim="4" friction="0.9 0.01 0.001"
                solimp="0.9 0.99 0.001" solref="0.005 1" margin="0.001" contype="1" conaffinity="1" />
        </default>
        <default class="fingertip_pad_collision_3">
          <geom type="box" size="0.003 0.002 0.003" condim="4" friction="0.9 0.01 0.001"
                solimp="0.9 0.99 0.001" solref="0.005 1" margin="0.001" pos="-0.0055 0.002 0.05" contype="1" conaffinity="1" />
        </default>
        <default class="fingertip_pad_collision_4">
          <geom type="box" size="0.003 0.002 0.0035" condim="4" friction="0.9 0.01 0.001"
                solimp="0.9 0.99 0.001" solref="0.005 1" margin="0.001" pos="0.0055 0.002 0.0395" contype="1" conaffinity="1" />
        </default>
        <default class="fingertip_pad_collision_5">
          <geom type="box" size="0.003 0.002 0.0035" condim="4" friction="0.9 0.01 0.001"
                solimp="0.9 0.99 0.001" solref="0.005 1" margin="0.001" pos="-0.0055 0.002 0.0395" contype="1" conaffinity="1" />
        </default>
      </default>
    </default>
  </default>

  <!-- ==================== 资源：材质、网格、纹理 ==================== -->
  <asset>
    <!-- 机械臂本体材质 -->
    <material class="panda" name="white"       rgba="1 1 1 1" />
    <material class="panda" name="off_white"   rgba="0.901961 0.921569 0.929412 1" />
    <material class="panda" name="black"       rgba="0.25 0.25 0.25 1" />
    <material class="panda" name="green"       rgba="0 1 0 1" />
    <material class="panda" name="light_blue"  rgba="0.039216 0.541176 0.780392 1" />

    <!-- 碰撞网格（STL/OBJ） -->
    <mesh name="link0_c" file="link0.stl" />
    <mesh name="link1_c" file="link1.stl" />
    <mesh name="link2_c" file="link2.stl" />
    <mesh name="link3_c" file="link3.stl" />
    <mesh name="link4_c" file="link4.stl" />
    <mesh name="link5_c0" file="link5_collision_0.obj" />
    <mesh name="link5_c1" file="link5_collision_1.obj" />
    <mesh name="link5_c2" file="link5_collision_2.obj" />
    <mesh name="link6_c" file="link6.stl" />
    <mesh name="link7_c" file="link7.stl" />
    <mesh name="hand_c" file="hand.stl" />

    <!-- 视觉网格（OBJ，高精度） -->
    <mesh file="link0_0.obj" />  <mesh file="link0_1.obj" />
    <mesh file="link0_2.obj" />  <mesh file="link0_3.obj" />
    <mesh file="link0_4.obj" />  <mesh file="link0_5.obj" />
    <mesh file="link0_7.obj" />  <mesh file="link0_8.obj" />
    <mesh file="link0_9.obj" />  <mesh file="link0_10.obj" />
    <mesh file="link0_11.obj" />
    <mesh file="link1.obj" />
    <mesh file="link2.obj" />
    <mesh file="link3_0.obj" />  <mesh file="link3_1.obj" />
    <mesh file="link3_2.obj" />  <mesh file="link3_3.obj" />
    <mesh file="link4_0.obj" />  <mesh file="link4_1.obj" />
    <mesh file="link4_2.obj" />  <mesh file="link4_3.obj" />
    <mesh file="link5_0.obj" />  <mesh file="link5_1.obj" />
    <mesh file="link5_2.obj" />
    <mesh file="link6_0.obj" />  <mesh file="link6_1.obj" />
    <mesh file="link6_2.obj" />  <mesh file="link6_3.obj" />
    <mesh file="link6_4.obj" />  <mesh file="link6_5.obj" />
    <mesh file="link6_6.obj" />  <mesh file="link6_7.obj" />
    <mesh file="link6_8.obj" />  <mesh file="link6_9.obj" />
    <mesh file="link6_10.obj" /> <mesh file="link6_11.obj" />
    <mesh file="link6_12.obj" /> <mesh file="link6_13.obj" />
    <mesh file="link6_14.obj" /> <mesh file="link6_15.obj" />
    <mesh file="link6_16.obj" />
    <mesh file="link7_0.obj" />  <mesh file="link7_1.obj" />
    <mesh file="link7_2.obj" />  <mesh file="link7_3.obj" />
    <mesh file="link7_4.obj" />  <mesh file="link7_5.obj" />
    <mesh file="link7_6.obj" />  <mesh file="link7_7.obj" />
    <mesh file="hand_0.obj" />   <mesh file="hand_1.obj" />
    <mesh file="hand_2.obj" />   <mesh file="hand_3.obj" />
    <mesh file="hand_4.obj" />
    <mesh file="finger_0.obj" /> <mesh file="finger_1.obj" />

    <!-- 地面棋盘格纹理与材质 -->
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2" />
  </asset>

  <!-- ==================== 场景（世界物体） ==================== -->
  <worldbody>
    <!-- 全局光照 -->
    <light name="sun"  directional="true" diffuse="0.7 0.7 0.7" specular="0.3 0.3 0.3" dir="0 -0.5 -1" />
    <light name="fill" directional="true" diffuse="0.3 0.3 0.3" specular="0.0 0.0 0.0" dir="1 0.5 1" />

    <!-- 地面（装饰性平面） -->
    <geom name="floor" size="10 10 0.1" type="plane" material="groundplane" />

    <!-- 桌子（带四条腿） -->
    <body name="table" pos="0 0 0.78">
      <geom name="table_top" type="box" size="1.0 1.0 0.02"
            rgba="0.45 0.3 0.15 1" friction="0.8 0.02 0.01" contype="1" conaffinity="1"/>
      <body name="leg_0.5_0.5"   pos="0.7 0.7 -0.39">
        <geom type="cylinder" size="0.05 0.39" rgba="0.35 0.25 0.1 1" />
      </body>
      <body name="leg_0.5_-0.5"  pos="0.7 -0.7 -0.39">
        <geom type="cylinder" size="0.05 0.39" rgba="0.35 0.25 0.1 1" />
      </body>
      <body name="leg_-0.5_0.5"  pos="-0.7 0.7 -0.39">
        <geom type="cylinder" size="0.05 0.39" rgba="0.35 0.25 0.1 1" />
      </body>
      <body name="leg_-0.5_-0.5" pos="-0.7 -0.7 -0.39">
        <geom type="cylinder" size="0.05 0.39" rgba="0.35 0.25 0.1 1" />
      </body>
    </body>
    <!-- ==================== 机械臂本体 ==================== -->
    <!-- link0：基座，固定在世界坐标 (0,0,0.80) 桌子上方 -->
    <body name="link0" childclass="panda" pos="0 0 0.80">
      <inertial mass="0.629769" pos="-0.041018 -0.00014 0.049974"
                fullinertia="0.00315 0.00388 0.004285 8.2904e-7 0.00015 8.2299e-6" />
      <geom mesh="link0_0"  material="off_white" class="visual" />
      <geom mesh="link0_1"  material="black"     class="visual" />
      <geom mesh="link0_2"  material="off_white" class="visual" />
      <geom mesh="link0_3"  material="black"     class="visual" />
      <geom mesh="link0_4"  material="off_white" class="visual" />
      <geom mesh="link0_5"  material="black"     class="visual" />
      <geom mesh="link0_7"  material="white"     class="visual" />
      <geom mesh="link0_8"  material="white"     class="visual" />
      <geom mesh="link0_9"  material="black"     class="visual" />
      <geom mesh="link0_10" material="off_white" class="visual" />
      <geom mesh="link0_11" material="white"     class="visual" />
      <geom mesh="link0_c"  class="collision" />

      <!-- link1：关节1（绕Z轴），继承默认范围 ±2.8973 -->
      <body name="link1" pos="0 0 0.333">
        <inertial mass="4.970684" pos="0.003875 0.002081 -0.04762"
                  fullinertia="0.70337 0.70661 0.0091170 -0.00013900 0.0067720 0.019169" />
        <joint name="joint1" />
        <geom material="white" mesh="link1" class="visual" />
        <geom mesh="link1_c" class="collision" />

        <!-- link2：关节2（绕Z轴，范围受限） -->
        <body name="link2" quat="1 -1 0 0">
          <inertial mass="0.646926" pos="-0.003141 -0.02872 0.003495"
                    fullinertia="0.0079620 2.8110e-2 2.5995e-2 -3.925e-3 1.0254e-2 7.04e-4" />
          <joint name="joint2" range="-1.7628 1.7628" />
          <geom material="white" mesh="link2" class="visual" />
          <geom mesh="link2_c" class="collision" />

          <!-- link3：关节3 -->
          <body name="link3" pos="0 -0.316 0" quat="1 1 0 0">
            <joint name="joint3" />
            <inertial mass="3.228604" pos="2.7518e-2 3.9252e-2 -6.6502e-2"
                      fullinertia="3.7242e-2 3.6155e-2 1.083e-2 -4.761e-3 -1.1396e-2 -1.2805e-2" />
            <geom mesh="link3_0" material="white" class="visual" />
            <geom mesh="link3_1" material="white" class="visual" />
            <geom mesh="link3_2" material="white" class="visual" />
            <geom mesh="link3_3" material="black" class="visual" />
            <geom mesh="link3_c" class="collision" />

            <!-- link4：关节4（范围受限，强制肘部朝上） -->
            <body name="link4" pos="0.0825 0 0" quat="1 1 0 0">
              <inertial mass="3.587895" pos="-5.317e-2 1.04419e-1 2.7454e-2"
                        fullinertia="2.5853e-2 1.9552e-2 2.8323e-2 7.796e-3 -1.332e-3 8.641e-3" />
              <joint name="joint4" range="-3.0718 -0.0698" />
              <geom mesh="link4_0" material="white" class="visual" />
              <geom mesh="link4_1" material="white" class="visual" />
              <geom mesh="link4_2" material="black" class="visual" />
              <geom mesh="link4_3" material="white" class="visual" />
              <geom mesh="link4_c" class="collision" />

              <!-- link5：关节5 -->
              <body name="link5" pos="-0.0825 0.384 0" quat="1 -1 0 0">
                <inertial mass="1.225946" pos="-1.1953e-2 4.1065e-2 -3.8437e-2"
                          fullinertia="3.5549e-2 2.9474e-2 8.627e-3 -2.117e-3 -4.037e-3 2.29e-4" />
                <joint name="joint5" />
                <geom mesh="link5_0" material="black" class="visual" />
                <geom mesh="link5_1" material="white" class="visual" />
                <geom mesh="link5_2" material="white" class="visual" />
                <geom mesh="link5_c0" class="collision" />
                <geom mesh="link5_c1" class="collision" />
                <geom mesh="link5_c2" class="collision" />

                <!-- link6：关节6（范围受限） -->
                <body name="link6" quat="1 1 0 0">
                  <inertial mass="1.666555" pos="6.0149e-2 -1.4117e-2 -1.0517e-2"
                            fullinertia="1.964e-3 4.354e-3 5.433e-3 1.09e-4 -1.158e-3 3.41e-4" />
                  <joint name="joint6" range="-0.0175 3.7525" />
                  <geom mesh="link6_0"  material="off_white" class="visual" />
                  <geom mesh="link6_1"  material="white"     class="visual" />
                  <geom mesh="link6_2"  material="black"     class="visual" />
                  <geom mesh="link6_3"  material="white"     class="visual" />
                  <geom mesh="link6_4"  material="white"     class="visual" />
                  <geom mesh="link6_5"  material="white"     class="visual" />
                  <geom mesh="link6_6"  material="white"     class="visual" />
                  <geom mesh="link6_7"  material="light_blue" class="visual" />
                  <geom mesh="link6_8"  material="light_blue" class="visual" />
                  <geom mesh="link6_9"  material="black"     class="visual" />
                  <geom mesh="link6_10" material="black"     class="visual" />
                  <geom mesh="link6_11" material="white"     class="visual" />
                  <geom mesh="link6_12" material="green"     class="visual" />
                  <geom mesh="link6_13" material="white"     class="visual" />
                  <geom mesh="link6_14" material="black"     class="visual" />
                  <geom mesh="link6_15" material="black"     class="visual" />
                  <geom mesh="link6_16" material="white"     class="visual" />
                  <geom mesh="link6_c"  class="collision" />

                  <!-- link7：关节7（末端，连接手掌） -->
                  <body name="link7" pos="0.088 0 0" quat="1 1 0 0">
                    <inertial mass="7.35522e-01" pos="1.0517e-2 -4.252e-3 6.1597e-2"
                              fullinertia="1.2516e-2 1.0027e-2 4.815e-3 -4.28e-4 -1.196e-3 -7.41e-4" />
                    <joint name="joint7" />
                    <geom mesh="link7_0" material="white" class="visual" />
                    <geom mesh="link7_1" material="black" class="visual" />
                    <geom mesh="link7_2" material="black" class="visual" />
                    <geom mesh="link7_3" material="black" class="visual" />
                    <geom mesh="link7_4" material="black" class="visual" />
                    <geom mesh="link7_5" material="black" class="visual" />
                    <geom mesh="link7_6" material="black" class="visual" />
                    <geom mesh="link7_7" material="white" class="visual" />
                    <geom mesh="link7_c" class="collision" />

                    <!-- 手掌 hand -->
                    <body name="hand" pos="0 0 0.107" quat="0.9238795 0 0 -0.3826834">
                      <site name="TCP" pos="0 0 0.107" size="0.01" rgba="1 0 0 0.1" />
                      <inertial mass="0.73" pos="-0.01 0 0.03"
                                diaginertia="0.001 0.0025 0.0017" />
                      <geom mesh="hand_0" material="off_white" class="visual" />
                      <geom mesh="hand_1" material="black"     class="visual" />
                      <geom mesh="hand_2" material="black"     class="visual" />
                      <geom mesh="hand_3" material="white"     class="visual" />
                      <geom mesh="hand_4" material="off_white" class="visual" />
                      <geom mesh="hand_c" class="collision" />

                      <!-- 左手指 -->
                      <body name="left_finger" pos="0 0 0.0584">
                        <inertial mass="0.015" pos="0 0 0"
                                  diaginertia="2.375e-6 2.375e-6 7.5e-7" />
                        <joint name="finger_joint1" class="finger" />
                        <geom mesh="finger_0" material="off_white" class="visual" />
                        <geom mesh="finger_1" material="black"     class="visual" />
                        <geom mesh="finger_0" class="collision" />
                        <geom class="fingertip_pad_collision_1" />
                        <geom class="fingertip_pad_collision_2" />
                        <geom class="fingertip_pad_collision_3" />
                        <geom class="fingertip_pad_collision_4" />
                        <geom class="fingertip_pad_collision_5" />
                        <site name="left_finger_site" type="box" pos="0 0.004 0.045" size="0.007 0.005 0.007" rgba="1 0 0 1" />
                      </body>

                      <!-- 右手指 -->
                      <body name="right_finger" pos="0 0 0.0584" quat="0 0 0 1">
                        <inertial mass="0.015" pos="0 0 0"
                                  diaginertia="2.375e-6 2.375e-6 7.5e-7" />
                        <joint name="finger_joint2" class="finger" />
                        <geom mesh="finger_0" material="off_white" class="visual" />
                        <geom mesh="finger_1" material="black"     class="visual" />
                        <geom  mesh="finger_0" class="collision" />
                        <geom  class="fingertip_pad_collision_1" />
                        <geom  class="fingertip_pad_collision_2" />
                        <geom  class="fingertip_pad_collision_3" />
                        <geom  class="fingertip_pad_collision_4" />
                        <geom  class="fingertip_pad_collision_5" />
                        <site name="right_finger_site" type="box" pos="0 0.004 0.045" size="0.007 0.005 0.007" rgba="1 0 0 1" />
                      </body>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
      <!-- 基座装饰性底面（无碰撞） -->
      <geom name="panda_base_plate" type="cylinder" size="0.08 0.02"
            rgba="0.3 0.3 0.3 1" pos="0 0 -0.02" contype="0" conaffinity="0" />
    </body>

    <!-- ===================目标============================== -->
    <body name="target" pos="0.5 0.3 0.83">
      <freejoint/>
      <geom name="target_geom" mass="0.01" type="box" size="0.03 0.03 0.03" rgba="1.0 0.0 0.0 1" condim="4" friction="0.90 0.01 0.001" contype="1" conaffinity="1" solimp="0.95 0.99 0.001" solref="0.005 5" margin="0.001"/>
    </body>

    <body name="place" pos="0.6 -0.6 0.82">
        <site name="place_site" pos="0.0 0.0 0.05" size="0.01" rgba="1 0 0 1" />
        <geom name="place_bottom" type="box" size="0.1 0.1 0.02" conaffinity="1" contype="1" rgba="0 0 0 1"/>
        <geom name="place_left" type="box" size="0.02 0.1 0.05"  pos="-0.1 0 0.05" conaffinity="1" contype="1" rgba="0 0 0 1"/>
        <geom name="place_right" type="box" size="0.02 0.1 0.05"  pos="0.1 0 0.05" conaffinity="1" contype="1" rgba="0 0 0 1"/>
        <geom name="place_forward" type="box" size="0.1 0.02 0.05"  pos="0 0.1 0.05" conaffinity="1" contype="1" rgba="0 0 0 1"/>
        <geom name="place_back" type="box" size="0.1 0.02 0.05"  pos="0 -0.1 0.05" conaffinity="1" contype="1" rgba="0 0 0 1"/>
    </body>

  </worldbody>

  <!-- ==================== 肌腱：夹爪联动 ==================== -->
  <tendon>
    <fixed name="split">
      <joint joint="finger_joint1" coef="0.5" />
      <joint joint="finger_joint2" coef="0.5" />
    </fixed>
  </tendon>

  <!-- ==================== 等式约束：手指对称 ==================== -->
  <equality>
    <joint joint1="finger_joint1" joint2="finger_joint2"
           solimp="0.90 0.99 0.001" solref="0.005 1" />
  </equality>

  <!-- ==================== 执行器：7个手臂关节 + 1个肌腱（夹爪） ==================== -->
  <actuator>
    <!-- 关节1~7使用通用执行器，实现 PD 伺服控制 -->
    <general class="panda" name="actuator1" joint="joint1"
             gainprm="4500" biasprm="0 -4500 -450" />
    <general class="panda" name="actuator2" joint="joint2"
             gainprm="4500" biasprm="0 -4500 -450" ctrlrange="-1.7628 1.7628" />
    <general class="panda" name="actuator3" joint="joint3"
             gainprm="3500" biasprm="0 -3500 -350" />
    <general class="panda" name="actuator4" joint="joint4"
             gainprm="3500" biasprm="0 -3500 -350" ctrlrange="-3.0718 -0.0698" />
    <general class="panda" name="actuator5" joint="joint5"
             gainprm="2000" biasprm="0 -2000 -200" forcerange="-12 12" />
    <general class="panda" name="actuator6" joint="joint6"
             gainprm="2000" biasprm="0 -2000 -200" forcerange="-12 12"
             ctrlrange="-0.0175 3.7525" />
    <general class="panda" name="actuator7" joint="joint7"
             gainprm="2000" biasprm="0 -2000 -200" forcerange="-12 12" />

    <!-- 夹爪肌腱执行器：ctrlrange 0~255 对应全闭~全开 -->
    <general class="panda" name="actuator8" tendon="split"
             forcerange="-100 100" ctrlrange="0 255"
             gainprm="1.0 0 0" biasprm="0 -6400 -640" />
  </actuator>

  <sensor>
    <touch name="touch_left" site="left_finger_site" />
    <touch name="touch_right" site="right_finger_site"/>
  </sensor>

  <!-- ==================== 关键帧：Home 姿态 ==================== -->
  <keyframe>
    <key name="home"
         qpos="0 0 0 -1.57079 0 1.57079 -0.7853 0.04 0.04 0.5 0.3 0.83 1 0 0 0"
         ctrl="0 0 0 -1.57079 0 1.57079 -0.7853 255" />1
    <key name="grasp"
     qpos="0 0 0 -1.57079 0 1.57079 -0.7853 0.04 0.04"
     ctrl="0 0 0 -1.57079 0 1.57079 -0.7853 0" />
  </keyframe>

  <!-- ==================== 碰撞排除：避免相邻连杆自碰 ==================== -->
